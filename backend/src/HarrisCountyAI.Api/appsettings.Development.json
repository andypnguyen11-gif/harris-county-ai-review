{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "Mode": "LocalDevelopment",
    "LocalDevelopment": {
      "Issuer": "HarrisCountyAI.Local",
      "Audience": "HarrisCountyAI.Api",
      "SigningKey": "LOCAL-DEV-ONLY-signing-key-not-a-production-secret-0123456789",
      "TokenLifetimeMinutes": 480,
      "Users": [
        {
          "Username": "dev.reviewer",
          "DisplayName": "Dev Reviewer",
          "Roles": ["Reviewer"]
        },
        {
          "Username": "dev.admin",
          "DisplayName": "Dev Administrator",
          "Roles": ["Administrator"]
        }
      ]
    },
    "EntraId": {
      "Authority": "",
      "Audience": ""
    }
  },
  "ConnectionStrings": {
    "Database": "Server=localhost,1433;Database=HarrisCountyAI;User Id=sa;Password=LocalDev!Passw0rd;TrustServerCertificate=True"
  },
  "Database": {
    "ApplyMigrationsAtStartup": true
  },
  "BlobStorage": {
    "ConnectionString": "UseDevelopmentStorage=true",
    "CaseDocumentsContainerName": "case-documents",
    "KnowledgeBaseContainerName": "knowledge-base",
    "MaxFileSizeBytes": 52428800
  }
}
